---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { tags } from '../../data/articles.js';

export function getStaticPaths() {
  return tags.map((tag) => ({
    params: { slug: tag.slug },
    props: { tag },
  }));
}

const { tag } = Astro.props;
---

<Base
  title={`Tag : ${tag.nom}`}
  description={`Articles associés au tag ${tag.nom}.`}
  canonical={`/tags/${tag.slug}/`}
>
  <p class="fil"><a href="/tags/">← Tous les tags</a></p>
  <p class="etiquette">Tag</p>
  <h1>{tag.nom}</h1>
  <p class="intro">
    {tag.articles.length} article
    {tag.articles.length > 1 ? 's' : ''} avec ce tag.
  </p>

  <div class="grille">
    {
      tag.articles.map((article) => (
        <ArticleCard article={article} heading="h2" />
      ))
    }
  </div>
</Base>
