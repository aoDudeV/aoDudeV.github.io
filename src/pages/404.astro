---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page introuvable"
  description="La page demandée n’existe pas ou a été déplacée."
  noindex
>
  <section class="hero">
    <p class="etiquette">Erreur 404</p>
    <h1>Page introuvable</h1>
    <p class="intro">
      Cette adresse n’existe pas ou a été déplacée. Les anciennes URL Hexo sont
      normalement redirigées automatiquement.
    </p>
    <div class="actions">
      <a class="bouton" href="/">Retour à l’accueil</a>
      <a class="bouton secondaire" href="/articles/">Voir tous les articles</a>
    </div>
  </section>
</Base>
