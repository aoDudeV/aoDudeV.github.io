---
import '../styles/global.css';
import { SITE_DESCRIPTION, SITE_NAME, SITE_URL } from '../data/articles.js';

const {
  title = SITE_NAME,
  description = SITE_DESCRIPTION,
  canonical,
  type = 'website',
  image = '/favicon.png',
  publishedTime,
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL(SITE_URL);
const canonicalURL = new URL(canonical ?? Astro.url.pathname, site);
const pageTitle = title === SITE_NAME ? title : `${title} — ${SITE_NAME}`;
const ogImage = new URL(image, site);
const chemin = Astro.url.pathname;

function estActif(prefixe) {
  return prefixe === '/' ? chemin === '/' : chemin.startsWith(prefixe);
}
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fafafa" />
    <script is:inline>
      (() => {
        const systemeSombre =
          window.matchMedia &&
          window.matchMedia('(prefers-color-scheme: dark)').matches;
        let choix = null;
        try {
          choix = localStorage.getItem('fil-rouge-theme');
        } catch {
          choix = null;
        }
        const sombre = choix === 'dark' || (choix !== 'light' && systemeSombre);
        document.documentElement.dataset.theme = sombre ? 'dark' : 'light';
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', sombre ? '#121212' : '#fafafa');
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE_NAME} — flux RSS`}
      href={new URL('/rss.xml', site)}
    />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>

    <header class="entete">
      <div class="conteneur entete-interieur">
        <a class="logo" href="/">📝 {SITE_NAME}</a>
        <div class="entete-actions">
          <nav class="nav" aria-label="Navigation principale">
            <a href="/" aria-current={estActif('/') ? 'page' : undefined}>Accueil</a>
            <a href="/articles/" aria-current={estActif('/articles/') ? 'page' : undefined}>Articles</a>
            <a href="/categories/" aria-current={estActif('/categories/') ? 'page' : undefined}>Catégories</a>
            <a href="/tags/" aria-current={estActif('/tags/') ? 'page' : undefined}>Tags</a>
            <a href="/archives/" aria-current={estActif('/archives/') ? 'page' : undefined}>Archives</a>
            <a href="/a-propos/" aria-current={estActif('/a-propos/') ? 'page' : undefined}>À propos</a>
          </nav>
          <button
            class="bascule-theme"
            type="button"
            aria-label="Changer de thème"
            title="Changer de thème"
          >
            <svg
              class="icone-soleil"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true"
              focusable="false"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
            </svg>
            <svg
              class="icone-lune"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main id="contenu" class="conteneur">
      <slot />
    </main>

    <footer class="pied">
      <div class="conteneur pied-contenu">
        <p>{SITE_NAME} — version statique publiée sur GitHub Pages.</p>
        <p>
          <a href="/rss.xml">Flux RSS</a> ·
          <a href="/sitemap.xml">Plan du site</a> ·
          <a href="https://github.com/aoDudeV">GitHub</a>
        </p>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const racine = document.documentElement;
        const bouton = document.querySelector('.bascule-theme');
        const meta = document.querySelector('meta[name="theme-color"]');
        if (!bouton) return;

        const appliquer = (theme) => {
          const sombre = theme === 'dark';
          racine.dataset.theme = sombre ? 'dark' : 'light';
          bouton.setAttribute(
            'aria-label',
            sombre ? 'Activer le thème clair' : 'Activer le thème sombre',
          );
          bouton.setAttribute(
            'title',
            sombre ? 'Passer au thème clair' : 'Passer au thème sombre',
          );
          if (meta) meta.setAttribute('content', sombre ? '#121212' : '#fafafa');
        };

        appliquer(racine.dataset.theme === 'dark' ? 'dark' : 'light');

        bouton.addEventListener('click', () => {
          const suivant = racine.dataset.theme === 'dark' ? 'light' : 'dark';
          try {
            localStorage.setItem('fil-rouge-theme', suivant);
          } catch {
            /* le choix ne sera pas mémorisé */
          }
          appliquer(suivant);
        });

        const media = window.matchMedia
          ? window.matchMedia('(prefers-color-scheme: dark)')
          : null;
        if (!media) return;

        const suivreSysteme = (evenement) => {
          let choix = null;
          try {
            choix = localStorage.getItem('fil-rouge-theme');
          } catch {
            choix = null;
          }
          if (choix === 'light' || choix === 'dark') return;
          appliquer(evenement.matches ? 'dark' : 'light');
        };

        if (media.addEventListener) {
          media.addEventListener('change', suivreSysteme);
        } else if (media.addListener) {
          media.addListener(suivreSysteme);
        }
      })();
    </script>
  </body>
</html>
