---
const { to, title = 'Redirection' } = Astro.props;
const destination = new URL(to, Astro.site ?? 'https://aodudev.github.io');
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={destination} />
    <title>{title}</title>
  </head>
  <body>
    <p>
      Cette page a déménagé.
      <a href={to}>Continuer vers la nouvelle adresse</a>.
    </p>
  </body>
</html>
